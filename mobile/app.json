{
  "expo": {
    "name": "NyayaLabel AI Officer",
    "slug": "nyayalabel-ai-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.in.nyayalabel.officer"
    },
    "android": {
      "package": "gov.in.nyayalabel.officer",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {},
    "splash": {
      "backgroundColor": "#020617"
    },
    "plugins": [
      "@morrowdigital/watermelondb-expo-plugin",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NyayaLabel AI Officer to access your camera for product inspection."
        }
      ]
    ]
  }
}
